  "description": "Mobile-first lead capture PWA for event marketers: snap a badge or card, add a voice note, export a clean CSV.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
