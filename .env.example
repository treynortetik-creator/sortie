# Sortie environment variables. Copy to .env.local for local dev (it is gitignored).
# Everything here is read on the SERVER only. Nothing is exposed to the browser.

# --- Required (unless every user brings their own key in Settings) -------------------------
# https://openrouter.ai/keys  Use a key with a spending limit.
OPENROUTER_API_KEY=

# --- Strongly recommended for any public URL -----------------------------------------------
# Shared code your team types once in Settings. Without it, anyone who finds the URL can spend your credits.
SORTIE_ACCESS_CODE=

# Per-day cap on server-key spend in USD, per server instance (default 5). Requests stop when reached.
SORTIE_DAILY_BUDGET_USD=5

# --- Optional ------------------------------------------------------------------------------
# Models (defaults chosen from OpenRouter's catalog; see AUDIT.md for the comparison).
# SORTIE_EXTRACT_MODEL=google/gemini-3.1-flash-lite
# SORTIE_STT_MODEL=openai/whisper-large-v3-turbo

# Requests per minute per IP (default 60).
# SORTIE_RATE_LIMIT_PER_MIN=60

# Let clients choose any model even with the server key (default off: only bring-your-own-key users can).
# SORTIE_ALLOW_MODEL_OVERRIDE=1

# By default Sortie asks OpenRouter to route only to providers that do not retain or train on your data.
# Set to 1 to allow all providers (more models available, weaker privacy).
# SORTIE_ALLOW_DATA_COLLECTION=1

# Shown to OpenRouter as the app URL (HTTP-Referer) for their rankings page. Harmless to omit.
# SORTIE_APP_URL=https://your-sortie.example
